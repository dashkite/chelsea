doctype html

include mixins

head

  block head

    meta( key = "charset" charset = "utf-8" )

    meta(
      key = "viewport"
      name = "viewport"
      content = "width=device-width, initial-scale=1.0"
    )
    
    meta(
      key = "og:site-name"
      property = "og:site_name"
      content = "Brooklyn Lookbook"
    )

    +preconnect( "https://fonts.googleapis.com" )
    +preconnect( "https://fonts.gstatic.com" )

    //- link( key = "ico" rel ="icon" href =`https://${ media }/images/dashkite/favicon.ico` sizes="any" )
    //- link( key = "icon" rel ="icon" href =`https://${ media }/images/dashkite/icon.svg` type="image/svg+xml" )
    //- link( key = "apple-touch" rel="apple-touch-icon" href=`https://${ media }/images/dashkite/apple-touch-icon.png`)

    +stylesheet( "https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" )
    +stylesheet( "https://unpkg.com/trix@2.0.8/dist/trix.css" )
    
body

  header
    block header
      +logo()

  main
    block main

  footer
    block footer