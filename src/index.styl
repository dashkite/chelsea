@require "./theme"

body 

  & > header
    display flex
    justify-content space-between
    align-items center
    padding 1rem 2rem
    border-bottom 1px solid var(--accent)

    & > .logo

      & > a
        display flex
        flex-flow row wrap
        align-items end
        column-gap 1rem
        row-gap 0.5rem
        div
          display flex
          align-items center
          color var(--background)
          background-color var(--highlight)
          padding 0.5rem 
          border-radius 0.5rem
          gap 0.25rem

          i
            font-size 1rem

          h1
            text-transform none
            font-family "Crete Round", sans-serif
            font-optical-sizing auto
            font-weight 400
            font-style normal
            letter-spacing -0.5px
            font-size 1.25rem
            line-height 1

        .tag
          text-wrap nowrap
          font-family "Oxfanium", sans-serif
          font-optical-sizing auto
          font-weight 400
          font-style normal
          font-size 10px
          line-height 1
          color var(--highlight)
          padding 4px
          border 1px solid var(--accent)
          border-radius 4px
          margin-block-end 1px

    & > nav
      display flex
      gap 1rem
      span
        text-wrap nowrap

main
  display flex
  flex-direction column
  align-items center
  width 100%

  & > .page
    display none
    flex-direction column
    width 100%
    max-width var(--copy-max-width)

    &.active
      display flex

    & > .view
      display none
      flex-direction column
      padding-block 0.5rem
      padding-inline 0.5rem

      &.active
        display flex

      //- view header
      & > header
        margin-block 0.5rem
        border-bottom 1px solid var(--accent)
        padding-block-end 1rem
      
      & > *
        padding-inline-start 1rem

#copyright
  text-align center
  padding 2rem
  font-size var(--small-copy-font-size)
